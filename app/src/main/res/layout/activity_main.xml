<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AnyKey"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Play music in any app, then start. When Android asks what to share, choose the entire screen (only audio is used)." />

        <TextView
            android:id="@+id/semitoneLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/down"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="−" />

            <SeekBar
                android:id="@+id/semitones"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="24" />

            <Button
                android:id="@+id/up"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="+" />
        </LinearLayout>

        <TextView
            android:id="@+id/centsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/cents"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <Button
                android:id="@+id/resetCents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Play transposed audio on:" />

        <Spinner
            android:id="@+id/output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Start transposing" />

        <Button
            android:id="@+id/testTone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Play test tone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The test tone is a normal media sound. If the meters move with it but not with Spotify etc., capture works and those apps block it." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Captured from other apps" />

        <ProgressBar
            android:id="@+id/inputMeter"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transposed output" />

        <ProgressBar
            android:id="@+id/outputMeter"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textStyle="italic" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Experiment: can we hide the original?"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android captures audio after the media volume, so muting media also mutes what AnyKey hears. Instead: pick Alarm output before starting, then put media at its lowest step. AnyKey boosts the captured audio back up, so the transposed copy is loud and the original barely audible." />

        <TextView
            android:id="@+id/volumes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/muteMedia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Media to lowest" />

            <Button
                android:id="@+id/restoreMedia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Restore media" />
        </LinearLayout>

        <Button
            android:id="@+id/outputVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show output-stream volume slider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Experiment: system-wide EQ trick"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Music apps announce their audio to equalizer apps. AnyKey attaches a built-in effect that turns the original down 60 dB. Keep media volume normal and use Alarm output." />

        <TextView
            android:id="@+id/eqSessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/hideOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hide original (EQ trick)" />
    </LinearLayout>
</ScrollView>
